def agora():
    return datetime.now().astimezone()


def iso_agora():
    return agora().isoformat(timespec="seconds")


def dia_agora():
    return agora().strftime("%Y-%m-%d")


def hora_curta(dt_iso):
    return datetime.fromisoformat(dt_iso).strftime("%H:%M")


def dia_legivel(dia):
    dt = datetime.strptime(dia, "%Y-%m-%d")
    nomes = ["seg", "ter", "qua", "qui", "sex", "sab", "dom"]
    return f"{dt.strftime('%d-%m-%Y')} {nomes[dt.weekday()]}"


def periodo_do_horario(dt):
    hora = dt.hour
    if 5 <= hora <= 11:
        return "Manhã"
    if 12 <= hora <= 17:
        return "Tarde"
    if 18 <= hora <= 23:
        return "Noite"
    return "Madrugada"


def formatar_duracao(segundos):
    segundos = max(0, int(segundos))
    horas, resto = divmod(segundos, 3600)
    minutos, segs = divmod(resto, 60)
    if horas > 0:
        return f"{horas}h {minutos:02d}m"
    if minutos > 0:
        return f"{minutos}m {segs:02d}s"
    return f"{segs}s"


def formatar_duracao_curta(segundos):
    segundos = max(0, int(segundos))
    horas, resto = divmod(segundos, 3600)
    minutos, _ = divmod(resto, 60)
    if horas > 0:
        return f"{horas}h{minutos:02d}m"
    return f"{max(1, minutos)}m" if segundos >= 60 else f"{segundos}s"


def garantir_dir():
    DIR_CONFIG.mkdir(parents=True, exist_ok=True)


def conectar():
    garantir_dir()
    conexao = sqlite3.connect(CAMINHO_BD)
    conexao.row_factory = sqlite3.Row
    conexao.execute("PRAGMA foreign_keys = ON")
    return conexao


def iniciar_bd(conexao):
    conexao.executescript(
        """
        CREATE TABLE IF NOT EXISTS atividades (
            id INTEGER PRIMARY KEY,
            nome TEXT NOT NULL UNIQUE COLLATE NOCASE,
            criada_em TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS registros (
            id INTEGER PRIMARY KEY,
            atividade_id INTEGER NOT NULL REFERENCES atividades(id),
            feito_em TEXT NOT NULL,
            dia TEXT NOT NULL,
            periodo TEXT NOT NULL,
            segundos INTEGER
        );

        CREATE TABLE IF NOT EXISTS timer_ativo (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            atividade_id INTEGER NOT NULL REFERENCES atividades(id),
            iniciado_em TEXT NOT NULL
        );
        """
    )
    conexao.commit()


def obter_atividade_por_nome(conexao, nome):
    return conexao.execute(
        "SELECT id, nome FROM atividades WHERE nome = ? COLLATE NOCASE",
        (nome.strip(),),
    ).fetchone()


def buscar_atividades_por_parcial(conexao, nome):
    termo = f"%{nome.strip()}%"
    return conexao.execute(
        "SELECT id, nome FROM atividades WHERE nome LIKE ? COLLATE NOCASE ORDER BY nome",
        (termo,),
    ).fetchall()


def obter_ou_criar_atividade(conexao, nome):
    nome = nome.strip()
    existente = obter_atividade_por_nome(conexao, nome)
    if existente:
        return existente, False
    conexao.execute(
        "INSERT INTO atividades (nome, criada_em) VALUES (?, ?)",
        (nome, iso_agora()),
    )
    conexao.commit()
    return obter_atividade_por_nome(conexao, nome), True


def resolver_atividade(conexao, nome):
    nome = nome.strip()
    exata = obter_atividade_por_nome(conexao, nome)
    if exata:
        return exata, None
    candidatas = buscar_atividades_por_parcial(conexao, nome)
    if len(candidatas) == 1:
        return candidatas[0], None
    if len(candidatas) > 1:
        nomes = ", ".join(c["nome"] for c in candidatas)
        return None, f'"{nome}" combina com: {nomes}\nSeja mais específico.'
    return None, None


def contar_registros_hoje(conexao, atividade_id):
    linha = conexao.execute(
        "SELECT COUNT(*) AS total FROM registros WHERE atividade_id = ? AND dia = ?",
        (atividade_id, dia_agora()),
    ).fetchone()
    return linha["total"]


def inserir_registro(conexao, atividade_id, feito_em, segundos=None):
    dt = datetime.fromisoformat(feito_em)
    conexao.execute(
        """
        INSERT INTO registros (atividade_id, feito_em, dia, periodo, segundos)
        VALUES (?, ?, ?, ?, ?)
        """,
        (atividade_id, feito_em, dt.strftime("%Y-%m-%d"), periodo_do_horario(dt), segundos),
    )
    conexao.commit()


def obter_timer_ativo(conexao):
    return conexao.execute(
        """
        SELECT t.atividade_id, t.iniciado_em, a.nome
        FROM timer_ativo t
        JOIN atividades a ON a.id = t.atividade_id
        WHERE t.id = 1
        """
    ).fetchone()


def definir_timer_ativo(conexao, atividade_id, iniciado_em):
    conexao.execute("DELETE FROM timer_ativo WHERE id = 1")
    conexao.execute(
        "INSERT INTO timer_ativo (id, atividade_id, iniciado_em) VALUES (1, ?, ?)",
        (atividade_id, iniciado_em),
    )
    conexao.commit()


def limpar_timer_ativo(conexao):
    conexao.execute("DELETE FROM timer_ativo WHERE id = 1")
    conexao.commit()


def tocar_som_conclusao():
    if os.environ.get("ANEDONIA_SOUND", "1") == "0":
        return
    caminho = DIR_CONFIG / "som.ogg"
    if not caminho.exists():
        return
    for cmd in (["paplay", str(caminho)], ["pw-play", str(caminho)], ["aplay", "-q", str(caminho)]):
        if shutil.which(cmd[0]):
            try:
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                pass


